# MongoDB Atlas Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ncert_learning?retryWrites=true&w=majority

# Google Gemini API (rotation keys — add up to 10)
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_key_here

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=ncert-learning-rag
PINECONE_HOST=https://your-index-host.svc.pinecone.io

PINECONE_MASTER_INDEX=your_master_index_name
PINECONE_MASTER_HOST=https://your-master-host.svc.pinecone.io

PINECONE_MATH_INDEX=your_math_index
PINECONE_MATH_HOST=https://your-math-host.svc.pinecone.io

PINECONE_PHYSICS_INDEX=your_physics_index
PINECONE_PHYSICS_HOST=https://your-physics-host.svc.pinecone.io

PINECONE_CHEMISTRY_INDEX=your_chemistry_index
PINECONE_CHEMISTRY_HOST=https://your-chemistry-host.svc.pinecone.io

PINECONE_BIOLOGY_INDEX=your_biology_index
PINECONE_BIOLOGY_HOST=https://your-biology-host.svc.pinecone.io

PINECONE_SOCIAL_INDEX=your_social_index
PINECONE_SOCIAL_HOST=https://your-social-host.svc.pinecone.io

PINECONE_ENGLISH_INDEX=your_english_index
PINECONE_ENGLISH_HOST=https://your-english-host.svc.pinecone.io

PINECONE_HINDI_INDEX=your_hindi_index
PINECONE_HINDI_HOST=https://your-hindi-host.svc.pinecone.io

# JWT Authentication (REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars

# Application Settings
APP_NAME="NCERT AI Learning Backend"
APP_VERSION="1.0.0"
DEBUG=True

# CORS Settings (Frontend URL)
FRONTEND_URL=http://localhost:5173

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@your-domain.com
