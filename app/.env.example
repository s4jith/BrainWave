# BrainWave Flutter App — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and must NOT be committed.

# ─── API ─────────────────────────────────────────────────────────────────────

# Set to the backend ROOT — do NOT include /api (the app adds it automatically).
#
# Android emulator → host machine localhost
API_BASE_URL=http://10.0.2.2:8000
#
# Physical Android/iOS device → use your machine's LAN IP
# API_BASE_URL=http://192.168.1.100:8000
#
# Production backend (Render / Railway / etc.)
# API_BASE_URL=https://ncert-working-backend-latest.onrender.com
# API_BASE_URL=https://api.your-domain.com

# ─── App ─────────────────────────────────────────────────────────────────────

APP_NAME=BrainWave
APP_ENV=development        # development | staging | production

# ─── Feature Flags ───────────────────────────────────────────────────────────

ENABLE_PDF_VIEWER=true
ENABLE_CAREER_TEST=true
ENABLE_IMAGE_CHAT=true
